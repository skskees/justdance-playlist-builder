# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — NEVER commit real secrets.

# --- Google OAuth (from Google Cloud Console > Credentials > OAuth 2.0 Client ID) ---
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# --- YouTube Data API key (Console > Credentials > API key) ---
# Only used by the offline data-pipeline scripts, NOT at runtime. Optional.
YOUTUBE_API_KEY="your-api-key"

# --- NextAuth ---
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-random-32-byte-base64-string"
# Local dev URL. In production set this to your deployed URL
# (e.g. https://your-app.vercel.app).
NEXTAUTH_URL="http://localhost:3000"

# --- Admin access ---
# Comma-separated list of emails allowed into /admin.
ADMIN_EMAILS="you@example.com,teammate@example.com"
